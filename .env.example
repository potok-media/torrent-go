# Port the HTTP API listens on (read from PORT, not TORRENTGO_PORT).
PORT=5282

# App log level: debug|info|warn|error (slog text on stdout). libav errors and HTTP
# access failures are always logged; routine polling traffic is muted regardless.
POTOK_LOG_LEVEL=info

# Optional: override the built-in TMDB key.
TMDB_API_KEY=

# Enable the standalone management panel and protect it with Basic Auth.
TORRENTGO_ENABLE_WEBUI=false
POTOK_AUTH_USER=
POTOK_AUTH_PASS=

# Intel/AMD GPU passthrough on Linux. Leave commented for software encoding.
# GPU_DEVICE=/dev/dri:/dev/dri
# Optional when several render nodes are mapped into the container.
# POTOK_VAAPI_DEVICE=/dev/dri/renderD128
POTOK_DISABLE_HWACCEL=0

# One hardware encode at a time is the safest default for mini PCs. Raise only after validating the driver.
POTOK_VIDEO_TRANSCODE_CONCURRENCY=1
